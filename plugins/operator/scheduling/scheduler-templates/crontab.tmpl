# Operator ritual schedule — generated by /operator:setup-scheduling
#
# Variables substituted by the wizard:
#   {{MINUTE}}    — minute (0-59)
#   {{HOUR}}      — hour (0-23)
#   {{WEEKDAY}}   — 1 (Monday) or 5 (Friday)
#   {{COMMAND}}   — "monday-packet" or "friday-wrap"
#   {{CLAUDE_BIN}} — absolute path to the claude binary
#   {{STATE_DIR}} — ~/.claude/operator (or $OPERATOR_STATE_DIR)
#
# Install (appends to existing crontab, doesn't replace):
#   crontab -l 2>/dev/null | { cat; cat ~/.claude/operator/scheduling/crontab.txt; } | crontab -
#
# Verify:
#   crontab -l | grep operator
#
# Disable:
#   crontab -e  → delete the lines marked `# operator-ritual`

# operator-ritual: {{COMMAND}}
{{MINUTE}} {{HOUR}} * * {{WEEKDAY}} OPERATOR_STATE_DIR={{STATE_DIR}} {{CLAUDE_BIN}} -p "/operator:{{COMMAND}} --from-inbox" >> {{STATE_DIR}}/scheduling/{{COMMAND}}.log 2>&1
