<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd template for a scheduled Operator ritual.

  Variables substituted by /operator:setup-scheduling:
    {{COMMAND}}   — "monday-packet" or "friday-wrap"
    {{CLAUDE_BIN}} — absolute path to the claude binary
    {{HOME}}      — user's home directory
    {{STATE_DIR}} — ~/.claude/operator (or $OPERATOR_STATE_DIR)
    {{HOUR}}      — hour (0-23)
    {{MINUTE}}    — minute (0-59)
    {{WEEKDAY}}   — 1 (Monday) or 5 (Friday)

  Install:
    launchctl load ~/.claude/operator/scheduling/com.operator.{{COMMAND}}.plist

  Verify:
    launchctl list | grep operator

  Disable:
    launchctl unload ~/.claude/operator/scheduling/com.operator.{{COMMAND}}.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.operator.{{COMMAND}}</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{CLAUDE_BIN}}</string>
        <string>-p</string>
        <string>/operator:{{COMMAND}} --from-inbox</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>{{WEEKDAY}}</integer>
        <key>Hour</key>
        <integer>{{HOUR}}</integer>
        <key>Minute</key>
        <integer>{{MINUTE}}</integer>
    </dict>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>{{HOME}}</string>
        <key>OPERATOR_STATE_DIR</key>
        <string>{{STATE_DIR}}</string>
    </dict>

    <key>StandardOutPath</key>
    <string>{{STATE_DIR}}/scheduling/{{COMMAND}}.log</string>

    <key>StandardErrorPath</key>
    <string>{{STATE_DIR}}/scheduling/{{COMMAND}}.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
